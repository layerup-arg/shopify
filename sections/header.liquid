<header class="header" id="header">
  <div class="header__inner container">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          class="logo__img"
          width="{{ section.settings.logo_width }}"
          loading="eager"
        />
      {%- else -%}
        <span class="logo__icon">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <polygon points="14,2 26,8 26,20 14,26 2,20 2,8" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <polygon points="14,8 20,11 20,17 14,20 8,17 8,11" fill="currentColor" opacity="0.3"/>
          </svg>
        </span>
        <span class="logo__text">Layer<strong>Up</strong></span>
      {%- endif -%}
    </a>

    <nav class="nav" id="nav">
      <ul class="nav__list">
        {%- for link in section.settings.menu.links -%}
          {%- if link.title == 'Catálogo' or link.title == 'Catalogo' or link.handle == 'catalogo' -%}
            <li class="nav__item nav__item--dropdown" id="catalogDropdownItem">
              <button class="nav__dropdown-trigger" id="catalogTrigger" aria-expanded="false" aria-haspopup="true">
                {{ link.title }}
                <svg class="nav__chevron" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <div class="nav__dropdown" id="catalogDropdown" role="menu">
                <div class="nav__dropdown-inner">
                  <div class="nav__dropdown-group">
                    <span class="nav__dropdown-label">Destacados</span>
                    {%- if collections['novedades'] != empty -%}
                      <a href="{{ collections['novedades'].url }}" class="nav__dropdown-link" role="menuitem">
                        <span class="nav__dropdown-icon">✦</span>
                        Novedades
                        <span class="nav__dropdown-count">{{ collections['novedades'].products_count }}</span>
                      </a>
                    {%- endif -%}
                    {%- if collections['frontpage'] != empty -%}
                      <a href="{{ collections['frontpage'].url }}" class="nav__dropdown-link" role="menuitem">
                        <span class="nav__dropdown-icon">⭐</span>
                        Productos destacados
                        <span class="nav__dropdown-count">{{ collections['frontpage'].products_count }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                  {%- assign other_cols = collections | where: 'published', true -%}
                  {%- assign has_others = false -%}
                  {%- for col in collections -%}
                    {%- unless col.handle == 'novedades' or col.handle == 'frontpage' or col.handle == 'all' -%}
                      {%- assign has_others = true -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  {%- if has_others -%}
                    <div class="nav__dropdown-divider"></div>
                    <div class="nav__dropdown-group">
                      <span class="nav__dropdown-label">Categorías</span>
                      {%- for col in collections -%}
                        {%- unless col.handle == 'novedades' or col.handle == 'frontpage' or col.handle == 'all' -%}
                          <a href="{{ col.url }}" class="nav__dropdown-link" role="menuitem">
                            <span class="nav__dropdown-icon">·</span>
                            {{ col.title }}
                            <span class="nav__dropdown-count">{{ col.products_count }}</span>
                          </a>
                        {%- endunless -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  <div class="nav__dropdown-divider"></div>
                  <a href="{{ routes.all_products_collection_url }}" class="nav__dropdown-link nav__dropdown-link--all" role="menuitem">
                    Ver todos los productos →
                  </a>
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="nav__item">
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="icon-btn" aria-label="Buscar" onclick="window.location='{{ routes.search_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
        </svg>
      </button>
      <button class="icon-btn" aria-label="Cuenta" onclick="window.location='{{ routes.account_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </button>
      <button class="icon-btn cart-btn" aria-label="Carrito" onclick="window.location='{{ routes.cart_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
      <button class="hamburger" id="hamburger" aria-label="Menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Ancho del logo (px)",
      "min": 80,
      "max": 300,
      "step": 4,
      "default": 140,
      "unit": "px"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
