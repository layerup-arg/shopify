<header class="header" id="header">
  <div class="header__inner container">
    <a href="{{ routes.root_url }}" class="logo">
      <span class="logo__icon">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <polygon points="14,2 26,8 26,20 14,26 2,20 2,8" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <polygon points="14,8 20,11 20,17 14,20 8,17 8,11" fill="currentColor" opacity="0.3"/>
          <line x1="14" y1="2" x2="14" y2="8" stroke="currentColor" stroke-width="1.5"/>
          <line x1="26" y1="8" x2="20" y2="11" stroke="currentColor" stroke-width="1.5"/>
          <line x1="26" y1="20" x2="20" y2="17" stroke="currentColor" stroke-width="1.5"/>
          <line x1="14" y1="26" x2="14" y2="20" stroke="currentColor" stroke-width="1.5"/>
          <line x1="2" y1="20" x2="8" y2="17" stroke="currentColor" stroke-width="1.5"/>
          <line x1="2" y1="8" x2="8" y2="11" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <span class="logo__text">{{ shop.name | split: ' ' | first }}<strong>{{ shop.name | split: ' ' | last }}</strong></span>
    </a>

    <nav class="nav" id="nav">
      <ul class="nav__list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="icon-btn" aria-label="Buscar" onclick="window.location='{{ routes.search_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
        </svg>
      </button>
      <button class="icon-btn" aria-label="Cuenta" onclick="window.location='{{ routes.account_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </button>
      <button class="icon-btn cart-btn" aria-label="Carrito" onclick="window.location='{{ routes.cart_url }}'">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
      <button class="hamburger" id="hamburger" aria-label="Menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
