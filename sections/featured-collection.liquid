{%- liquid
  assign col_handle = section.settings.collection
  assign col = collections[col_handle]
  assign product_limit = section.settings.products_to_show
-%}

<section class="products section" id="{{ section.settings.section_id }}">
  <div class="container">
    <div class="section-header section-header--row">
      <div>
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.show_view_all and col != blank -%}
        <a href="{{ col.url }}" class="btn btn--outline btn--sm">Ver todos →</a>
      {%- endif -%}
    </div>

    <div class="products__grid{% if section.settings.columns == '3' %} products__grid--featured{% endif %}">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: product_limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholders while the collection is empty {%- endcomment -%}
        {%- for i in (1..product_limit) -%}
          <article class="product-card">
            <div class="product-card__media">
              <div class="product-card__img product-card__img--desk" style="height:220px;">
                <div style="opacity:.3;font-size:.75rem;color:#fff;">Sin productos aún</div>
              </div>
            </div>
            <div class="product-card__info">
              <span class="product-card__cat">—</span>
              <h3 class="product-card__name" style="color:#ccc;">Producto de ejemplo</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "ID de sección (ancla)",
      "default": "productos"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "Colección"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Productos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Cantidad de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas",
      "options": [
        { "value": "4", "label": "4 columnas" },
        { "value": "3", "label": "3 columnas" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar enlace Ver todos",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
