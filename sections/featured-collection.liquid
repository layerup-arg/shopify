{%- liquid
  assign col = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show
-%}

<section class="carousel-section section" id="{{ section.settings.section_id }}">
  <div class="container">
    <div class="carousel-section__header">
      <div>
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>
      <div class="carousel-nav">
        <button class="carousel-nav__btn" data-dir="prev" aria-label="Anterior">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button class="carousel-nav__btn" data-dir="next" aria-label="Siguiente">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="carousel-track-wrap">
    <div class="carousel-track container">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: product_limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">
              <div class="product-card__img product-card__img--desk">
                <div style="opacity:.3;font-size:.75rem;color:#fff;">Sin productos</div>
              </div>
            </div>
            <div class="product-card__info">
              <span class="product-card__cat">—</span>
              <h3 class="product-card__name" style="color:#ccc;">Producto de ejemplo</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('#{{ section.settings.section_id }}');
    if (!section) return;
    var track = section.querySelector('.carousel-track');
    var prevBtn = section.querySelector('[data-dir="prev"]');
    var nextBtn = section.querySelector('[data-dir="next"]');
    var cardWidth = function() {
      var card = track.querySelector('.product-card');
      return card ? card.offsetWidth + 24 : 320;
    };
    if (prevBtn) prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -cardWidth(), behavior: 'smooth' });
    });
    if (nextBtn) nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: cardWidth(), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Carrusel de colección",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "ID de sección (ancla)",
      "default": "productos"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta",
      "default": "Colección"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Productos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Cantidad máxima de productos",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Carrusel de colección"
    }
  ]
}
{% endschema %}
