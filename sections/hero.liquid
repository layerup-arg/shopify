<section class="hero">
  <div class="hero__inner container">
    <div class="hero__content">
      <span class="hero__label">{{ section.settings.badge }}</span>
      <h1 class="hero__title">
        {{ section.settings.title_line1 }}
        <span class="hero__title-accent">{{ section.settings.title_line2 }}</span>
      </h1>
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>

      <div class="hero__features">
        {%- if section.settings.feature1 != blank -%}
          <div class="hero__feature">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
            <span>{{ section.settings.feature1 }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.feature2 != blank -%}
          <div class="hero__feature">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
            <span>{{ section.settings.feature2 }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.feature3 != blank -%}
          <div class="hero__feature">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>{{ section.settings.feature3 }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="hero__ctas">
        <a href="{{ routes.collections_url }}/{{ section.settings.catalog_handle }}" class="btn hero__btn-catalog">
          {{ section.settings.cta_catalog }}
        </a>
        <a href="https://wa.me/5491140928282?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20de%20LayerUp" class="btn hero__btn-wa" target="_blank" rel="noopener">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {{ section.settings.cta_whatsapp }}
        </a>
      </div>
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | default: shop.name }}"
          class="hero__img"
          loading="eager"
        />
      {%- else -%}
        <div class="hero__img-placeholder">
          <svg width="80" height="80" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24" opacity="0.25">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
          </svg>
          <p>Subí una foto desde el editor del tema</p>
        </div>
      {%- endif -%}

      <div class="hero__floats">
        {%- if section.settings.float1 != blank -%}
          <div class="hero__float">
            <span class="hero__float-icon">⭐</span>
            <div>
              <strong>{{ section.settings.float1 }}</strong>
              <span class="hero__float-stars">★★★★★</span>
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.float2 != blank -%}
          <div class="hero__float">
            <span class="hero__float-icon">🚚</span>
            <div><strong>{{ section.settings.float2 }}</strong></div>
          </div>
        {%- endif -%}
        {%- if section.settings.float3 != blank -%}
          <div class="hero__float">
            <span class="hero__float-icon">🩷</span>
            <div><strong>{{ section.settings.float3 }}</strong></div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  background: #f0f4ff;
  padding: 36px 0 32px;
  overflow: hidden;
}
.hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  max-height: 420px;
}
.hero__label {
  display: inline-block;
  background: #dce8ff;
  color: #2d5dd4;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 99px;
  margin-bottom: 14px;
}
.hero__title {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 800;
  line-height: 1.15;
  color: var(--black);
  margin: 0 0 12px;
}
.hero__title-accent { color: #3b6ef0; display: block; }
.hero__subtitle {
  font-size: .9rem;
  color: var(--text-secondary);
  margin: 0 0 18px;
  line-height: 1.6;
}
.hero__features {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 24px;
}
.hero__feature {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: .82rem;
  color: var(--text-secondary);
  max-width: 130px;
  line-height: 1.4;
}
.hero__feature svg { flex-shrink: 0; margin-top: 1px; color: #3b6ef0; }
.hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.hero__btn-catalog {
  background: #3b6ef0;
  border-color: #3b6ef0;
  color: #fff;
  font-weight: 700;
}
.hero__btn-catalog:hover { background: #2d5dd4; border-color: #2d5dd4; color: #fff; }
.hero__btn-wa {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 2px solid #25d366;
  color: #1a9e4d;
  background: transparent;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 10px 20px;
  font-size: .9rem;
  text-decoration: none;
  transition: var(--transition);
  cursor: pointer;
}
.hero__btn-wa:hover { background: #25d366; color: #fff; }

/* Media side */
.hero__media { position: relative; }
.hero__img {
  width: 100%;
  height: 340px;
  border-radius: 20px;
  object-fit: cover;
  display: block;
}
.hero__img-placeholder {
  width: 100%;
  height: 340px;
  background: var(--surface);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--text-tertiary);
  font-size: .85rem;
}

/* Floating badge cards */
.hero__floats {
  position: absolute;
  right: -12px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.hero__float {
  background: #fff;
  border-radius: 14px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 4px 20px rgba(0,0,0,.10);
  min-width: 170px;
}
.hero__float strong { display: block; font-size: .8rem; line-height: 1.3; color: var(--black); }
.hero__float-stars { font-size: .7rem; color: #f59e0b; letter-spacing: 1px; display: block; }
.hero__float-icon { font-size: 1.5rem; line-height: 1; flex-shrink: 0; }

@media (max-width: 900px) {
  .hero__floats { right: 4px; }
  .hero__float { min-width: 130px; padding: 8px 10px; }
  .hero__float strong { font-size: .75rem; }
}
@media (max-width: 768px) {
  .hero { padding: 28px 0 24px; }
  .hero__inner {
    grid-template-columns: 1fr;
    gap: 24px;
    max-height: none;
  }
  .hero__img,
  .hero__img-placeholder { height: 220px; }
  .hero__floats {
    position: static;
    transform: none;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .hero__float { min-width: 0; flex: 1 1 130px; }
}
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge superior",
      "default": "Impresión 3D Personalizada"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Título línea 1",
      "default": "Regalos y souvenirs que hacen felices"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Título línea 2 (color acento)",
      "default": "a los chicos ⭐"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Productos únicos, personalizados y hechos con mucho detalle."
    },
    {
      "type": "text",
      "id": "feature1",
      "label": "Característica 1",
      "default": "Ideal para cumpleaños"
    },
    {
      "type": "text",
      "id": "feature2",
      "label": "Característica 2",
      "default": "Personalizá con nombre y colores"
    },
    {
      "type": "text",
      "id": "feature3",
      "label": "Característica 3",
      "default": "Materiales seguros y de calidad"
    },
    {
      "type": "text",
      "id": "cta_catalog",
      "label": "Texto botón catálogo",
      "default": "Ver catálogo"
    },
    {
      "type": "text",
      "id": "catalog_handle",
      "label": "Handle colección catálogo",
      "default": "all"
    },
    {
      "type": "text",
      "id": "cta_whatsapp",
      "label": "Texto botón WhatsApp",
      "default": "Consultá por WhatsApp"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto principal"
    },
    {
      "type": "text",
      "id": "float1",
      "label": "Tarjeta flotante 1",
      "default": "Más de 1200 chicos felices"
    },
    {
      "type": "text",
      "id": "float2",
      "label": "Tarjeta flotante 2",
      "default": "Envíos a todo el país"
    },
    {
      "type": "text",
      "id": "float3",
      "label": "Tarjeta flotante 3",
      "default": "Hecho en Argentina"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
