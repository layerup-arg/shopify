{%- paginate collection.products by 48 -%}

<div class="collection-page">

  <!-- ── HEADER ── -->
  <div class="collection-page__header">
    <div class="container">
      <nav class="collection-page__breadcrumb">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span>›</span>
        <span>{{ collection.title }}</span>
      </nav>
      <div class="collection-page__title-row">
        <div>
          <h1 class="collection-page__title">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}
            <p class="collection-page__desc">{{ collection.description }}</p>
          {%- endif -%}
        </div>
        <span class="collection-page__count">{{ collection.products_count }} producto{{ collection.products_count | pluralize: '', 's' }}</span>
      </div>
    </div>
  </div>

  <!-- ── GRID ── -->
  <div class="container">
    {%- if collection.products_count == 0 -%}
      <div class="collection-page__empty">
        <p>No hay productos en esta categoría todavía.</p>
        <a href="{{ routes.root_url }}" class="btn btn--primary">Volver al inicio</a>
      </div>
    {%- else -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm">← Anterior</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="btn btn--outline btn--sm">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="btn btn--primary btn--sm">{{ part.title }}</span>
            {%- else -%}
              <span class="pagination__ellipsis">…</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm">Siguiente →</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

</div>

{%- endpaginate -%}
