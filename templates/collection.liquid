<div class="collection-page section">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Categoría</span>
      <h1 class="section-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p style="color:var(--text-secondary);margin-top:12px;">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- if collection.products_count == 0 -%}
      <p style="color:var(--text-tertiary);text-align:center;padding:64px 0;">
        No hay productos en esta categoría todavía.
      </p>
    {%- else -%}
      <div class="products__grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination" style="display:flex;justify-content:center;gap:8px;margin-top:48px;">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--outline btn--sm">← Anterior</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="btn btn--outline btn--sm">{{ part.title }}</a>
            {%- else -%}
              <span class="btn btn--primary btn--sm">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--outline btn--sm">Siguiente →</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{%- paginate collection.products by 12 -%}{%- endpaginate -%}
