<div class="cart-page section">
  <div class="container" style="max-width:760px;">
    <div class="section-header">
      <h1 class="section-title">Tu carrito</h1>
    </div>

    {%- if cart.item_count == 0 -%}
      <div style="text-align:center;padding:80px 0;">
        <p style="color:var(--text-tertiary);margin-bottom:24px;">Tu carrito está vacío.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Ver productos</a>
      </div>
    {%- else -%}
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-item" data-item-key="{{ item.key }}">
            <div class="cart-item__img">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" loading="lazy" />
              {%- endif -%}
            </div>
            <div class="cart-item__info">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <span class="cart-item__variant">{{ item.variant.title }}</span>
              {%- endunless -%}
              <div class="cart-item__qty">
                <button type="button" class="qty-btn" data-action="decrease" aria-label="Reducir cantidad">−</button>
                <input
                  type="number"
                  class="qty-input"
                  value="{{ item.quantity }}"
                  min="1"
                  max="99"
                  aria-label="Cantidad"
                  data-item-key="{{ item.key }}"
                />
                <button type="button" class="qty-btn" data-action="increase" aria-label="Aumentar cantidad">+</button>
              </div>
            </div>
            <div class="cart-item__price">
              <span class="cart-item__line-price" data-item-key="{{ item.key }}">{{ item.final_line_price | money }}</span>
              <button type="button" class="cart-item__remove" data-item-key="{{ item.key }}" aria-label="Eliminar">Eliminar</button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div class="cart-summary__row">
          <span>Subtotal</span>
          <strong id="CartTotal">{{ cart.total_price | money }}</strong>
        </div>
        <p style="font-size:.8rem;color:var(--text-tertiary);margin:8px 0 24px;">Los envíos e impuestos se calculan en el checkout.</p>
        <a href="/checkout" class="btn btn--primary" style="width:100%;justify-content:center;padding:16px;font-size:1rem;display:flex;">
          Finalizar compra →
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.cart-items { display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px; }
.cart-item { display: flex; gap: 20px; padding: 20px; background: var(--white); border: 1px solid var(--surface-2); border-radius: var(--radius-lg); transition: var(--transition); }
.cart-item.updating { opacity: .5; pointer-events: none; }
.cart-item__img { width: 80px; height: 80px; border-radius: var(--radius-md); overflow: hidden; background: var(--surface); flex-shrink: 0; }
.cart-item__img img { width: 100%; height: 100%; object-fit: cover; }
.cart-item__info { flex: 1; min-width: 0; }
.cart-item__title { font-weight: 600; display: block; margin-bottom: 4px; color: var(--black); }
.cart-item__variant { font-size: .8rem; color: var(--text-tertiary); display: block; margin-bottom: 10px; }
.cart-item__qty { display: flex; align-items: center; gap: 8px; }
.qty-btn {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: var(--surface);
  border: 1.5px solid var(--surface-2);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 1rem;
  cursor: pointer;
  transition: var(--transition);
  flex-shrink: 0;
  color: var(--black);
}
.qty-btn:hover { background: var(--black); border-color: var(--black); color: var(--white); }
.qty-input {
  width: 52px;
  height: 30px;
  border: 1.5px solid var(--surface-2);
  border-radius: var(--radius-sm);
  text-align: center;
  font-family: 'Space Grotesk', sans-serif;
  font-size: .9rem;
  font-weight: 600;
  color: var(--black);
  background: var(--white);
  transition: border-color var(--transition);
  -moz-appearance: textfield;
}
.qty-input::-webkit-inner-spin-button,
.qty-input::-webkit-outer-spin-button { -webkit-appearance: none; }
.qty-input:focus { outline: none; border-color: var(--black); }
.cart-item__price { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; }
.cart-item__line-price { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1rem; }
.cart-item__remove { font-size: .75rem; color: var(--text-tertiary); cursor: pointer; background: none; border: none; font-family: inherit; padding: 0; transition: color var(--transition); }
.cart-item__remove:hover { color: #e74c3c; }
.cart-summary { background: var(--white); border: 1px solid var(--surface-2); border-radius: var(--radius-lg); padding: 28px; }
.cart-summary__row { display: flex; justify-content: space-between; font-size: 1.1rem; margin-bottom: 4px; }
</style>

<script>
(function() {
  function updateCartItem(key, quantity) {
    const item = document.querySelector(`.cart-item[data-item-key="${key}"]`);
    if (item) item.classList.add('updating');

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: quantity })
    })
    .then(r => r.json())
    .then(cart => {
      if (quantity === 0) {
        item?.remove();
      } else {
        if (item) item.classList.remove('updating');
        // Update line price
        const linePrice = item?.querySelector('.cart-item__line-price');
        if (linePrice) {
          const lineItem = cart.items.find(i => i.key === key);
          if (lineItem) linePrice.textContent = formatMoney(lineItem.final_line_price);
        }
      }
      // Update total
      const total = document.getElementById('CartTotal');
      if (total) total.textContent = formatMoney(cart.total_price);
      // Update header badge
      const badge = document.querySelector('.cart-badge');
      if (badge) {
        badge.textContent = cart.item_count;
        badge.style.display = cart.item_count > 0 ? 'flex' : 'none';
      }
      // If cart empty, reload to show empty state
      if (cart.item_count === 0) location.reload();
    })
    .catch(() => { if (item) item.classList.remove('updating'); });
  }

  function formatMoney(cents) {
    return '$' + (cents / 100).toLocaleString('es-AR', { minimumFractionDigits: 2 });
  }

  // +/- buttons
  document.querySelectorAll('.qty-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.cart-item');
      const input = item.querySelector('.qty-input');
      const key = input.dataset.itemKey;
      let val = parseInt(input.value) || 1;
      if (btn.dataset.action === 'increase') val = Math.min(val + 1, 99);
      if (btn.dataset.action === 'decrease') val = Math.max(val - 1, 1);
      input.value = val;
      updateCartItem(key, val);
    });
  });

  // Direct input edit — update on blur or Enter
  document.querySelectorAll('.qty-input').forEach(input => {
    function commit() {
      let val = parseInt(input.value);
      if (isNaN(val) || val < 1) { val = 1; input.value = 1; }
      if (val > 99) { val = 99; input.value = 99; }
      updateCartItem(input.dataset.itemKey, val);
    }
    input.addEventListener('blur', commit);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); input.blur(); } });
  });

  // Remove buttons
  document.querySelectorAll('.cart-item__remove').forEach(btn => {
    btn.addEventListener('click', () => updateCartItem(btn.dataset.itemKey, 0));
  });
})();
</script>
